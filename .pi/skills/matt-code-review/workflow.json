{
  "version": 1,
  "name": "matt-code-review",
  "mode": "parallel",
  "lanes": [
    {
      "key": "standards",
      "agent": "matt-reviewer",
      "skills": ["review-standards"],
      "timeoutMs": 900000,
      "taskPrefix": "执行 Standards 轴评审。任务必须声明 reviewKind。worktree：先 worktree-files；tracked 逐文件 worktree-diff，?? untracked 直接 read，deleted 只读 diff，R old -> new 对 old/new 分别读取 worktree diff；禁止用 ref...HEAD 作为工作区唯一证据。committed：先 diff-files ref，再逐文件 diff ref path，rename 同时核验 old/new。files：只读任务列出的文件且不调用 Git diff。只读取 changed/目标文件、标准文件和初始证据 allowlist；只有为消除已命名的 diff 不确定性时才扩展一级直接依赖，不得递归。FFF 必须搜索已命名 symbol 且 path 限定到任务 module/package；禁止项目扫描。缺少 reviewKind 或对应逐文件证据方式时立即 NO_EVIDENCE；证据足够时立即 PASS/FAIL，不得扩大范围制造 PASS。仓库明确标准优先于通用启发式；不要评判产品需求是否正确。",
      "gate": { "field": "verdict", "equals": "PASS" },
      "outputSchema": {
        "type": "object",
        "properties": {
          "axis": { "type": "string", "enum": ["standards"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_EVIDENCE"] },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "locations": { "type": "array", "items": { "type": "string" } },
                "recommendation": { "type": "string" }
              },
              "required": ["severity", "title", "evidence", "locations", "recommendation"],
              "additionalProperties": false
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["axis", "verdict", "summary", "findings", "notes"],
        "additionalProperties": false
      }
    },
    {
      "key": "spec",
      "agent": "matt-reviewer",
      "skills": ["review-spec"],
      "timeoutMs": 900000,
      "taskPrefix": "执行 Spec 轴评审。首个工具步骤必须 read 当前 ticket，随后 read 它明确引用的 parent spec 和其他显式规格来源并提取当前 ticket 验收行为；全部声明规格读取完成前禁止 git_read、FFF 和实现文件读取。之后按任务声明的 reviewKind 取证。worktree：先 worktree-files；tracked 逐文件 worktree-diff，?? untracked 直接 read，deleted 只读 diff，R old -> new 对 old/new 分别读取 worktree diff；禁止用 ref...HEAD 作为工作区唯一证据。committed：先 diff-files ref，再逐文件 diff ref path，rename 同时核验 old/new。files：只读任务列出的实现文件。不得读取未声明的 sibling/future tickets、ADR、context、roadmap 或迁移计划；只为已提取验收行为扩展一级依赖。FFF 必须指定任务 module/package path；禁止项目扫描。缺少 reviewKind 或对应逐文件证据方式时立即 NO_EVIDENCE；证据足够时立即 PASS/FAIL，不得扩大范围制造 PASS。",
      "gate": { "field": "verdict", "equals": "PASS" },
      "outputSchema": {
        "type": "object",
        "properties": {
          "axis": { "type": "string", "enum": ["spec"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_EVIDENCE"] },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "locations": { "type": "array", "items": { "type": "string" } },
                "recommendation": { "type": "string" }
              },
              "required": ["severity", "title", "evidence", "locations", "recommendation"],
              "additionalProperties": false
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["axis", "verdict", "summary", "findings", "notes"],
        "additionalProperties": false
      }
    }
  ]
}
