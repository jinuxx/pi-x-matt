{
  "version": 1,
  "name": "tdd",
  "mode": "pipeline",
  "lanes": [
    {
      "key": "implement",
      "stage": 1,
      "agent": "worker",
      "skills": ["tdd-executor"],
      "timeoutMs": 600000,
      "turnBudget": { "maxTurns": 36, "graceTurns": 4 },
      "taskPrefix": "执行已批准的 TDD 实现。你是唯一写者。严格使用任务中已确认的 seams、固定基线和允许范围；逐个 vertical slice 取得真实 RED 后写最小 GREEN。不要提交、推送、覆盖既有改动或顺手重构。任何 seam/范围/架构变化都先 contact_supervisor。完成后返回每轮 RED/GREEN、文件和命令的结构化证据。",
      "gate": {
        "field": "status",
        "equals": "COMPLETE",
        "nonEmpty": ["confirmedSeams", "cycles", "changedFiles", "commands"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["COMPLETE", "BLOCKED"] },
          "summary": { "type": "string", "minLength": 1 },
          "confirmedSeams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "interface": { "type": "string", "minLength": 1 },
                "behaviors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["name", "interface", "behaviors"],
              "additionalProperties": false
            }
          },
          "cycles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "test": { "type": "string", "minLength": 1 },
                "redEvidence": { "type": "string", "minLength": 1 },
                "greenEvidence": { "type": "string", "minLength": 1 },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["test", "redEvidence", "greenEvidence", "files"],
              "additionalProperties": false
            }
          },
          "changedFiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "commands": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "outcome": { "type": "string", "minLength": 1 }
              },
              "required": ["command", "outcome"],
              "additionalProperties": false
            }
          },
          "residualRisks": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["status", "summary", "confirmedSeams", "cycles", "changedFiles", "commands", "residualRisks"],
        "additionalProperties": false
      }
    },
    {
      "key": "standards",
      "stage": 2,
      "agent": "reviewer",
      "skills": ["review-standards"],
      "timeoutMs": 300000,
      "turnBudget": { "maxTurns": 12, "graceTurns": 2 },
      "taskPrefix": "在 implement stage 成功后执行 fresh Standards 复核。Dispatcher 会附加 implement 的 structuredOutput 作为 RED/GREEN 命令证据；结合 git_read status/worktree-files/worktree-diff、任务固定基线和真实文件核验，只读检查仓库规则、正确性、测试质量及范围。不要修改文件，不要审计未列入范围的基础设施。",
      "gate": { "field": "verdict", "equals": "PASS" },
      "outputSchema": {
        "type": "object",
        "properties": {
          "axis": { "type": "string", "enum": ["standards"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_EVIDENCE"] },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "locations": { "type": "array", "items": { "type": "string" } },
                "recommendation": { "type": "string" }
              },
              "required": ["severity", "title", "evidence", "locations", "recommendation"],
              "additionalProperties": false
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["axis", "verdict", "summary", "findings", "notes"],
        "additionalProperties": false
      }
    },
    {
      "key": "spec",
      "stage": 2,
      "agent": "reviewer",
      "skills": ["review-spec"],
      "timeoutMs": 300000,
      "turnBudget": { "maxTurns": 12, "graceTurns": 2 },
      "taskPrefix": "在 implement stage 成功后执行 fresh Spec 复核。Dispatcher 会附加 implement 的 structuredOutput 作为实现证据；结合 git_read status/worktree-files/worktree-diff、任务固定基线和真实文件核验，只依据任务中的明确需求、已确认 seams 与验收标准检查遗漏、错误行为和范围膨胀。不要修改文件；没有可用 spec 时返回 NO_EVIDENCE。",
      "gate": { "field": "verdict", "equals": "PASS" },
      "outputSchema": {
        "type": "object",
        "properties": {
          "axis": { "type": "string", "enum": ["spec"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_EVIDENCE"] },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "locations": { "type": "array", "items": { "type": "string" } },
                "recommendation": { "type": "string" }
              },
              "required": ["severity", "title", "evidence", "locations", "recommendation"],
              "additionalProperties": false
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["axis", "verdict", "summary", "findings", "notes"],
        "additionalProperties": false
      }
    }
  ]
}
