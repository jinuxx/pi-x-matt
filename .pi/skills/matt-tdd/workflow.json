{
  "version": 1,
  "name": "matt-tdd",
  "mode": "single",
  "lanes": [
    {
      "key": "implement",
      "agent": "matt-worker",
      "skills": ["tdd-executor"],
      "timeoutMs": 1200000,
      "taskPrefix": "作为唯一写者执行已确认的 TDD 实现。先阅读父会话提供的任务上下文与关键文件，按测试切入点逐个 vertical slice 取得真实 RED 后写最小 GREEN，最后运行相关聚焦测试。不要提交、推送或覆盖用户既有无关改动；需要产品或架构决策时使用 contact_supervisor。完成后调用 structured_output 返回证据。",
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["COMPLETE", "BLOCKED"] },
          "summary": { "type": "string", "minLength": 1 },
          "confirmedSeams": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "interface": { "type": "string", "minLength": 1 },
                "behaviors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["name", "interface", "behaviors"],
              "additionalProperties": false
            }
          },
          "cycles": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "test": { "type": "string", "minLength": 1 },
                "redEvidence": { "type": "string", "minLength": 1 },
                "greenEvidence": { "type": "string", "minLength": 1 },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["test", "redEvidence", "greenEvidence", "files"],
              "additionalProperties": false
            }
          },
          "changedFiles": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          },
          "commands": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "enum": ["RED", "GREEN", "related-regression"] },
                "exitCode": { "type": "integer" },
                "testCount": { "type": ["integer", "null"], "minimum": 0 },
                "outcome": { "type": "string", "minLength": 1 }
              },
              "required": ["command", "phase", "exitCode", "testCount", "outcome"],
              "additionalProperties": false
            }
          },
          "residualRisks": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["status", "summary", "confirmedSeams", "cycles", "changedFiles", "commands", "residualRisks"],
        "additionalProperties": false
      }
    }
  ]
}
