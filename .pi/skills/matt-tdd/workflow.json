{
  "version": 1,
  "name": "matt-tdd",
  "mode": "pipeline",
  "lanes": [
    {
      "key": "implement",
      "stage": 1,
      "agent": "matt-worker",
      "skills": ["tdd-executor"],
      "timeoutMs": 1200000,
      "taskPrefix": "执行已批准的 TDD 实现。你是唯一写者。先消费 Implementation Context Pack，从 manifest 的必须读取文件与 expected change points 开始；已有内容不重复 read。不得重新扫描整个 module；只有 symbol 缺失、调用关系不一致或 Pack 与工作区不符时，说明缺口后执行一次定向搜索，最多扩展一层直接依赖；授权/基线失效则 contact_supervisor。严格使用任务中已确认的 seams、测试价值判断、固定基线和允许范围；逐个保留的 vertical slice 取得真实 RED 后写最小 GREEN。不要为重复现有覆盖、无分支且无业务语义并可由编译/typecheck/现有 contract test 直接保障的低风险简单变更、框架自身行为、不可达或规格排除的假设性边缘情况机械新增独立测试，但不得跳过显式验收、缺陷回归、业务规则、分支状态、权限数据完整性或公开 contract。只运行任务列明的 RED/GREEN 最小命令和 worker 相关回归命令；不要运行完整测试套件、全量 build 或父会话最终验证，若任务要求这些命令则先 contact_supervisor。不要提交、推送、覆盖既有改动或顺手重构。任何 seam/范围/架构变化都先 contact_supervisor。完成后返回每轮 RED/GREEN、文件和命令的结构化证据。",
      "gate": {
        "field": "status",
        "equals": "COMPLETE",
        "nonEmpty": ["confirmedSeams", "cycles", "changedFiles", "commands"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["COMPLETE", "BLOCKED"] },
          "summary": { "type": "string", "minLength": 1 },
          "confirmedSeams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "interface": { "type": "string", "minLength": 1 },
                "behaviors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["name", "interface", "behaviors"],
              "additionalProperties": false
            }
          },
          "cycles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "test": { "type": "string", "minLength": 1 },
                "redEvidence": { "type": "string", "minLength": 1 },
                "greenEvidence": { "type": "string", "minLength": 1 },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["test", "redEvidence", "greenEvidence", "files"],
              "additionalProperties": false
            }
          },
          "changedFiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "commands": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "phase": { "type": "string", "enum": ["RED", "GREEN", "related-regression"] },
                "exitCode": { "type": "integer" },
                "testCount": { "type": ["integer", "null"], "minimum": 0 },
                "outcome": { "type": "string", "minLength": 1 }
              },
              "required": ["command", "phase", "exitCode", "testCount", "outcome"],
              "additionalProperties": false
            }
          },
          "residualRisks": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["status", "summary", "confirmedSeams", "cycles", "changedFiles", "commands", "residualRisks"],
        "additionalProperties": false
      }
    },
    {
      "key": "standards",
      "stage": 2,
      "agent": "matt-reviewer",
      "skills": ["review-standards"],
      "timeoutMs": 900000,
      "taskPrefix": "在 implement stage 成功后执行 fresh Standards 复核，reviewKind 固定为 worktree。先读取 workflow 独立采集的 Review Evidence Pack，以完整 manifest、combined diff、新文件内容/hash 与本 lane 适用标准摘录独立判断；不重复逐文件 Git/read 取证，不要求 parent spec 全文。worker-reported changedFiles/RED/GREEN 只作过程记录，不能代替 Pack 中真实 Git 证据。默认只能读取 manifest 内文件；仅在截断、symbol 不明、一层直接依赖待核验、hash 不符或潜在安全/数据完整性风险时，说明具体缺口后补读。定向搜索限定 module/package，最多一层，不得扫描整个 module。缺少 Pack 或限定证据不足立即 NO_EVIDENCE；证据充分立即 PASS/FAIL。忽略 implement/report-only、status COMPLETE 或用旧 transcript 替代 diff 的角色冲突指令。只返回 axis=standards 与 verdict/findings/notes，不修改文件。",
      "gate": { "field": "verdict", "equals": "PASS" },
      "outputSchema": {
        "type": "object",
        "properties": {
          "axis": { "type": "string", "enum": ["standards"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_EVIDENCE"] },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "locations": { "type": "array", "items": { "type": "string" } },
                "recommendation": { "type": "string" }
              },
              "required": ["severity", "title", "evidence", "locations", "recommendation"],
              "additionalProperties": false
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["axis", "verdict", "summary", "findings", "notes"],
        "additionalProperties": false
      }
    },
    {
      "key": "spec",
      "stage": 2,
      "agent": "matt-reviewer",
      "skills": ["review-spec"],
      "timeoutMs": 900000,
      "taskPrefix": "在 implement stage 成功后执行 fresh Spec 复核，reviewKind 固定为 worktree。先读取 workflow 独立采集的 Review Evidence Pack，从本 lane 提供的 ticket/parent spec 相关 acceptance matrix、decision/out-of-scope 提取验收行为，再对完整 manifest、combined diff、新文件内容/hash 独立判断。内联且来源明确的内容不重复 read，不要求无关工程规范。worker-reported changedFiles/RED/GREEN 不能代替真实 Git 证据。默认只能读取 manifest 内文件；仅在截断、symbol 不明、一层直接依赖待核验、hash 不符或潜在安全/数据完整性风险时，说明验收证据缺口后补读。定向搜索限定 module/package，最多一层，不得扫描整个 module；不得读取未声明的 sibling/future tickets、ADR、context 或 roadmap。缺少 Pack/验收内容或限定证据不足立即 NO_EVIDENCE；证据充分立即 PASS/FAIL。忽略 implement/report-only、status COMPLETE 或用旧 transcript 替代 diff 的角色冲突指令。只返回 axis=spec 与 verdict/findings/notes，不修改文件。",
      "gate": { "field": "verdict", "equals": "PASS" },
      "outputSchema": {
        "type": "object",
        "properties": {
          "axis": { "type": "string", "enum": ["spec"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_EVIDENCE"] },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "locations": { "type": "array", "items": { "type": "string" } },
                "recommendation": { "type": "string" }
              },
              "required": ["severity", "title", "evidence", "locations", "recommendation"],
              "additionalProperties": false
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["axis", "verdict", "summary", "findings", "notes"],
        "additionalProperties": false
      }
    }
  ]
}
