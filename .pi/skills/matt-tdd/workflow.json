{
  "version": 1,
  "name": "matt-tdd",
  "mode": "pipeline",
  "lanes": [
    {
      "key": "implement",
      "stage": 1,
      "agent": "matt-worker",
      "skills": ["tdd-executor"],
      "timeoutMs": 600000,
      "turnBudget": { "maxTurns": 36, "graceTurns": 4 },
      "taskPrefix": "执行已批准的 TDD 实现。你是唯一写者。严格使用任务中已确认的 seams、测试价值判断、固定基线和允许范围；逐个保留的 vertical slice 取得真实 RED 后写最小 GREEN。不要为重复现有覆盖、无分支且无业务语义并可由编译/typecheck/现有 contract test 直接保障的低风险简单变更、框架自身行为、不可达或规格排除的假设性边缘情况机械新增独立测试，但不得跳过显式验收、缺陷回归、业务规则、分支状态、权限数据完整性或公开 contract。只运行任务列明的 RED/GREEN 最小命令和 worker 相关回归命令；不要运行完整测试套件、全量 build 或父会话最终验证，若任务要求这些命令则先 contact_supervisor。不要提交、推送、覆盖既有改动或顺手重构。任何 seam/范围/架构变化都先 contact_supervisor。完成后返回每轮 RED/GREEN、文件和命令的结构化证据。",
      "gate": {
        "field": "status",
        "equals": "COMPLETE",
        "nonEmpty": ["confirmedSeams", "cycles", "changedFiles", "commands"]
      },
      "outputSchema": {
        "type": "object",
        "properties": {
          "status": { "type": "string", "enum": ["COMPLETE", "BLOCKED"] },
          "summary": { "type": "string", "minLength": 1 },
          "confirmedSeams": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "name": { "type": "string", "minLength": 1 },
                "interface": { "type": "string", "minLength": 1 },
                "behaviors": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["name", "interface", "behaviors"],
              "additionalProperties": false
            }
          },
          "cycles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "properties": {
                "test": { "type": "string", "minLength": 1 },
                "redEvidence": { "type": "string", "minLength": 1 },
                "greenEvidence": { "type": "string", "minLength": 1 },
                "files": {
                  "type": "array",
                  "minItems": 1,
                  "items": { "type": "string", "minLength": 1 }
                }
              },
              "required": ["test", "redEvidence", "greenEvidence", "files"],
              "additionalProperties": false
            }
          },
          "changedFiles": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "minLength": 1 }
          },
          "commands": {
            "type": "array",
            "minItems": 2,
            "items": {
              "type": "object",
              "properties": {
                "command": { "type": "string", "minLength": 1 },
                "outcome": { "type": "string", "minLength": 1 }
              },
              "required": ["command", "outcome"],
              "additionalProperties": false
            }
          },
          "residualRisks": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["status", "summary", "confirmedSeams", "cycles", "changedFiles", "commands", "residualRisks"],
        "additionalProperties": false
      }
    },
    {
      "key": "standards",
      "stage": 2,
      "agent": "matt-reviewer",
      "skills": ["review-standards"],
      "timeoutMs": 300000,
      "turnBudget": { "maxTurns": 12, "graceTurns": 2 },
      "taskPrefix": "在 implement stage 成功后执行 fresh Standards 复核。Dispatcher 会附加 implement 的 structuredOutput；以其中的 changedFiles 和 RED/GREEN 命令为实现证据，并结合任务列出的标准文件与初始证据边界。先核对 changedFiles，再使用带 path 的逐文件 worktree-diff。只有为消除一个已命名的 diff 不确定性时才扩展到一级直接调用者、被调用者、配置、映射或聚焦测试，不得递归。FFF 查询必须指定任务 module/package path；禁止目录级或全项目扫描。限定证据足够时立即 PASS/FAIL，不足时立即 NO_EVIDENCE，不得扩大范围制造 PASS。不要修改文件，不要审计未列入范围的基础设施。",
      "gate": { "field": "verdict", "equals": "PASS" },
      "outputSchema": {
        "type": "object",
        "properties": {
          "axis": { "type": "string", "enum": ["standards"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_EVIDENCE"] },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "locations": { "type": "array", "items": { "type": "string" } },
                "recommendation": { "type": "string" }
              },
              "required": ["severity", "title", "evidence", "locations", "recommendation"],
              "additionalProperties": false
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["axis", "verdict", "summary", "findings", "notes"],
        "additionalProperties": false
      }
    },
    {
      "key": "spec",
      "stage": 2,
      "agent": "matt-reviewer",
      "skills": ["review-spec"],
      "timeoutMs": 300000,
      "turnBudget": { "maxTurns": 12, "graceTurns": 2 },
      "taskPrefix": "在 implement stage 成功后执行 fresh Spec 复核。Dispatcher 会附加 implement 的 structuredOutput；以其中的 changedFiles 作为实现范围，只读取任务列出的当前 ticket、其明确引用的 parent spec、带 path 的逐文件 worktree-diff 和其他显式规格来源。不得默认读取 sibling/future tickets、ADR、context、roadmap 或迁移计划。只有为核验一条明确验收行为时才扩展到一级实现依赖，不得递归。FFF 查询必须指定任务 module/package path；禁止目录级或全项目扫描。限定证据足够时立即 PASS/FAIL，不足时立即 NO_EVIDENCE，不得扩大范围制造 PASS。不要修改文件。",
      "gate": { "field": "verdict", "equals": "PASS" },
      "outputSchema": {
        "type": "object",
        "properties": {
          "axis": { "type": "string", "enum": ["spec"] },
          "verdict": { "type": "string", "enum": ["PASS", "FAIL", "NO_EVIDENCE"] },
          "summary": { "type": "string" },
          "findings": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "severity": { "type": "string", "enum": ["P0", "P1", "P2"] },
                "title": { "type": "string" },
                "evidence": { "type": "string" },
                "locations": { "type": "array", "items": { "type": "string" } },
                "recommendation": { "type": "string" }
              },
              "required": ["severity", "title", "evidence", "locations", "recommendation"],
              "additionalProperties": false
            }
          },
          "notes": { "type": "array", "items": { "type": "string" } }
        },
        "required": ["axis", "verdict", "summary", "findings", "notes"],
        "additionalProperties": false
      }
    }
  ]
}
