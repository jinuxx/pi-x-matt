                      "behaviors"
                    ],
                    "additionalProperties": false
                  }
                },
                "cycles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "minLength": 1
                      },
                      "redEvidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "greenEvidence": {
                        "type": "string",
                        "minLength": 1
                      },
