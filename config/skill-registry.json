                "summary",
                "confirmedSeams",
                "cycles",
                "changedFiles",
                "commands",
                "residualRisks"
              ],
              "additionalProperties": false
            }
          },
          {
            "key": "standards",
            "stage": 2,
            "agent": "reviewer",
            "skills": [
              "review-standards"
            ],
            "timeoutMs": 300000,
            "turnBudget": {
              "maxTurns": 12,
              "graceTurns": 2
            },
            "taskPrefix": "在 implement stage 成功后执行 fresh Standards 复核。Dispatcher 会附加 implement 的 structuredOutput 作为 RED/GREEN 命令证据；结合 git_read status/worktree-files/worktree-diff、任务固定基线和真实文件核验，只读检查仓库规则、正确性、测试质量及范围。不要修改文件，不要审计未列入范围的基础设施。",
            "gate": {
              "field": "verdict",
              "equals": "PASS"
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "axis": {
                  "type": "string",
                  "enum": [
                    "standards"
                  ]
