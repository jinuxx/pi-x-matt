      "sourcePath": ".pi/skills/tdd/SKILL.md",
      "sourceDigest": "f5d85ca26b9a8e59102e04c7a80ef1bf883e1bbfa20a6549fd29bc41c1461927",
      "workflowPath": ".pi/skills/tdd/workflow.json",
      "workflowDigest": "6bb97cfc20e9fe5ea3645dbd62222c275f357f14136f9069c0e9b4f2e1ef241c",
      "workflow": {
        "version": 1,
        "name": "tdd",
        "mode": "pipeline",
        "lanes": [
          {
            "key": "implement",
            "stage": 1,
            "agent": "worker",
            "skills": [
              "tdd-executor"
            ],
            "timeoutMs": 600000,
            "turnBudget": {
              "maxTurns": 24,
              "graceTurns": 4
            },
            "taskPrefix": "执行已批准的 TDD 实现。你是唯一写者。严格使用任务中已确认的 seams、固定基线和允许范围；逐个 vertical slice 取得真实 RED 后写最小 GREEN。不要提交、推送、覆盖既有改动或顺手重构。任何 seam/范围/架构变化都先 contact_supervisor。完成后返回每轮 RED/GREEN、文件和命令的结构化证据。",
            "gate": {
              "field": "status",
              "equals": "COMPLETE",
              "nonEmpty": [
                "confirmedSeams",
                "cycles",
                "changedFiles",
                "commands"
              ]
            },
            "outputSchema": {
              "type": "object",
              "properties": {
                "status": {
                  "type": "string",
                  "enum": [
                    "COMPLETE",
                    "BLOCKED"
                  ]
                },
                "summary": {
                  "type": "string",
                  "minLength": 1
                },
                "confirmedSeams": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "name": {
                        "type": "string",
                        "minLength": 1
                      },
                      "interface": {
                        "type": "string",
                        "minLength": 1
                      },
                      "behaviors": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "name",
                      "interface",
                      "behaviors"
                    ],
                    "additionalProperties": false
                  }
                },
                "cycles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "properties": {
                      "test": {
                        "type": "string",
                        "minLength": 1
                      },
                      "redEvidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "greenEvidence": {
                        "type": "string",
                        "minLength": 1
                      },
                      "files": {
                        "type": "array",
                        "minItems": 1,
                        "items": {
                          "type": "string",
                          "minLength": 1
                        }
                      }
                    },
                    "required": [
                      "test",
                      "redEvidence",
                      "greenEvidence",
                      "files"
                    ],
                    "additionalProperties": false
                  }
                },
                "changedFiles": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "commands": {
                  "type": "array",
                  "minItems": 2,
                  "items": {
                    "type": "object",
                    "properties": {
                      "command": {
                        "type": "string",
                        "minLength": 1
                      },
                      "outcome": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "required": [
                      "command",
                      "outcome"
                    ],
                    "additionalProperties": false
                  }
                },
                "residualRisks": {
                  "type": "array",
                  "items": {
                    "type": "string"
                  }
                }
              },
              "required": [
